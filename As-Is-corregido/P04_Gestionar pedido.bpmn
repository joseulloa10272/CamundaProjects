<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Maderos" targetNamespace="https://maderos.example/bpmn/PR-SERV-001" exporter="Camunda Web Modeler" exporterVersion="27cc6be" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_P03_cans" name="Cancelación total comunicada por el cliente"/>
  <bpmn:message id="Msg_P03_incs" name="Inconformidad durante el servicio"/>
  <bpmn:message id="Msg_P03_ads" name="Solicitud adicional"/>
  <bpmn:message id="Msg_P03_cuenta" name="Solicitud de cuenta recibida"/>
  <bpmn:message id="Msg_P02_ret" name="Cliente comunica retiro"/>
  <bpmn:escalation id="Esc_Cancelacion" name="Cancelación total" escalationCode="CANCELAR_SERVICIO"/>
  <bpmn:process id="P04" name="04 · Registro manual y atención de cada pedido" isExecutable="false">
    <bpmn:documentation>El pedido se registra únicamente en papel. El salonero lleva físicamente ese documento a cocina; no se utiliza un programa para ingresar pedidos ni se imprimen comandas desde un sistema. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P04_lanes">
      <bpmn:lane id="P04_lane_0" name="Salonero">
        <bpmn:flowNodeRef>P04_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_tomar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_papel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_llevar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P04_lane_1" name="Personal de cocina">
        <bpmn:flowNodeRef>P04_recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_ver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_falt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P04_fin</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P04_pendientes</bpmn:flowNodeRef><bpmn:flowNodeRef>P04_pendientes_end</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P04_s" name="Pedido inicial o adicional">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:outgoing>P04_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P04_tomar" name="Recibir el pedido inicial o adicional">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f1</bpmn:incoming>
      <bpmn:outgoing>P04_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P04_papel" name="Registrar manualmente el pedido en papel">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f2</bpmn:incoming>
      <bpmn:outgoing>P04_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P04_confirm" name="Confirmar el pedido y las observaciones con el cliente">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f3</bpmn:incoming>
      <bpmn:outgoing>P04_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P04_llevar" name="Llevar físicamente el pedido escrito a cocina">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f4</bpmn:incoming>
      <bpmn:outgoing>P04_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P04_recibir" name="Recibir y revisar pedido escrito en cocina">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f5</bpmn:incoming>
      <bpmn:outgoing>P04_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="P04_f1" sourceRef="P04_s" targetRef="P04_tomar"/>
    <bpmn:sequenceFlow id="P04_f2" sourceRef="P04_tomar" targetRef="P04_papel"/>
    <bpmn:sequenceFlow id="P04_f3" sourceRef="P04_papel" targetRef="P04_confirm"/>
    <bpmn:sequenceFlow id="P04_f4" sourceRef="P04_confirm" targetRef="P04_llevar"/>
    <bpmn:sequenceFlow id="P04_f5" sourceRef="P04_llevar" targetRef="P04_recibir"/>
    <bpmn:sequenceFlow id="P04_f6" sourceRef="P04_recibir" targetRef="P04_ver"/>
    <bpmn:sequenceFlow id="P04_f7" sourceRef="P04_ver" targetRef="P04_g"/>
    <bpmn:task id="P04_ver" name="Verificar la disponibilidad de los productos solicitados">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f6</bpmn:incoming>
      <bpmn:outgoing>P04_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P04_g" name="¿Productos disponibles?">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f7</bpmn:incoming>
      <bpmn:outgoing>P04_f8</bpmn:outgoing>
      <bpmn:outgoing>P04_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="P04_falt" name="Resolver producto no disponible" calledElement="P06">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="P06"/>
      </bpmn:extensionElements>
      <bpmn:incoming>P04_f9</bpmn:incoming>
      <bpmn:outgoing>Flow_14m6by2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:callActivity id="P04_prep" name="Preparar y entregar lotes" calledElement="P05">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="P05"/>
      </bpmn:extensionElements>
      <bpmn:incoming>P04_f8</bpmn:incoming>
      <bpmn:incoming>P04_pendientes_next</bpmn:incoming>
      <bpmn:outgoing>P04_f13</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:documentation>Una instancia por lote de entrega real, sin imponer tamaño ni espera conjunta de toda la mesa. Abstracción descriptiva pendiente de revisión operacional.</bpmn:documentation>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:endEvent id="P04_fin" name="Pedido atendido">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1;U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P04_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P04_f8" name="Sí" sourceRef="P04_g" targetRef="P04_prep">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P04_f9" name="No" sourceRef="P04_g" targetRef="P04_falt">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14m6by2" sourceRef="P04_falt" targetRef="P04_pendientes"/>
    <bpmn:sequenceFlow id="P04_f13" sourceRef="P04_prep" targetRef="P04_fin"/>
  <bpmn:exclusiveGateway id="P04_pendientes" name="¿Quedan productos para preparar?" default="P04_pendientes_alt"><bpmn:incoming>Flow_14m6by2</bpmn:incoming><bpmn:outgoing>P04_pendientes_next</bpmn:outgoing><bpmn:outgoing>P04_pendientes_alt</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="P04_pendientes_next" sourceRef="P04_pendientes" targetRef="P04_prep" name="Sí"><bpmn:conditionExpression>Quedan productos disponibles</bpmn:conditionExpression></bpmn:sequenceFlow><bpmn:endEvent id="P04_pendientes_end" name="Sin productos pendientes"><bpmn:incoming>P04_pendientes_alt</bpmn:incoming></bpmn:endEvent><bpmn:sequenceFlow id="P04_pendientes_alt" sourceRef="P04_pendientes" targetRef="P04_pendientes_end" name="No"/></bpmn:process>
  <bpmn:collaboration id="P04_collab">
    <bpmn:participant id="P04_restaurant" name="Restaurante Maderos" processRef="P04"/>
