<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Maderos" targetNamespace="https://maderos.example/bpmn/PR-SERV-001" exporter="Camunda Web Modeler" exporterVersion="27cc6be" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_P03_cans" name="Cancelación total comunicada por el cliente"/>
  <bpmn:message id="Msg_P03_incs" name="Inconformidad durante el servicio"/>
  <bpmn:message id="Msg_P03_ads" name="Solicitud adicional"/>
  <bpmn:message id="Msg_P03_cuenta" name="Solicitud de cuenta recibida"/>
  <bpmn:message id="Msg_P02_ret" name="Cliente comunica retiro"/>
  <bpmn:escalation id="Esc_Cancelacion" name="Cancelación total" escalationCode="CANCELAR_SERVICIO"/>
  <bpmn:process id="P05" name="05 · Preparación y entrega de un producto o lote" isExecutable="false">
    <bpmn:documentation>Un lote contiene uno o varios productos entregados juntos. Las ramas de alimentos y bebidas se activan solo si el lote los contiene; la ejecución simultánea entre áreas está confirmada. Otros lotes se entregan independientemente. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P05_lanes">
      <bpmn:lane id="P05_lane_2" name="Personal de entrega / salonero">
        <bpmn:flowNodeRef>P05_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05_lane_1" name="Encargado de bebidas">
        <bpmn:flowNodeRef>P05_avb</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_drink</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P05_lane_0" name="Cocina">
        <bpmn:flowNodeRef>P05_food</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P05_avf</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P05_s" name="Lote por preparar">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:outgoing>P05_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="P05_split" name="Preparación según contenido del pedido">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f1</bpmn:incoming>
      <bpmn:outgoing>P05_f2</bpmn:outgoing>
      <bpmn:outgoing>P05_f3</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="P05_food" name="Preparar los alimentos solicitados">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f2</bpmn:incoming>
      <bpmn:outgoing>P05_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:inclusiveGateway id="P05_join" name="Productos del lote listos">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f6</bpmn:incoming>
      <bpmn:incoming>P05_f7</bpmn:incoming>
      <bpmn:outgoing>P05_f8</bpmn:outgoing>
    </bpmn:inclusiveGateway>
    <bpmn:task id="P05_avf" name="Informar que los alimentos están listos para entregar">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f4</bpmn:incoming>
      <bpmn:outgoing>P05_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P05_verify" name="Verificar los alimentos y las bebidas contra el pedido escrito">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f8</bpmn:incoming>
      <bpmn:outgoing>P05_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="P05_f1" sourceRef="P05_s" targetRef="P05_split"/>
    <bpmn:sequenceFlow id="P05_f2" name="Incluye alimentos" sourceRef="P05_split" targetRef="P05_food">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Incluye alimentos</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_f3" name="Incluye bebidas" sourceRef="P05_split" targetRef="P05_drink">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Incluye bebidas</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P05_f5" sourceRef="P05_drink" targetRef="P05_avb"/>
    <bpmn:sequenceFlow id="P05_f7" sourceRef="P05_avb" targetRef="P05_join"/>
    <bpmn:sequenceFlow id="P05_f4" sourceRef="P05_food" targetRef="P05_avf"/>
    <bpmn:sequenceFlow id="P05_f6" sourceRef="P05_avf" targetRef="P05_join"/>
    <bpmn:sequenceFlow id="P05_f8" sourceRef="P05_join" targetRef="P05_verify"/>
    <bpmn:sequenceFlow id="P05_f9" sourceRef="P05_verify" targetRef="P05_rec"/>
    <bpmn:sequenceFlow id="P05_f10" sourceRef="P05_rec" targetRef="P05_ent"/>
    <bpmn:sequenceFlow id="P05_f12" sourceRef="P05_ent" targetRef="P05_fin"/>
    <bpmn:task id="P05_avb" name="Informar que las bebidas están listas para entregar">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f5</bpmn:incoming>
      <bpmn:outgoing>P05_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P05_drink" name="Preparar las bebidas solicitadas">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f3</bpmn:incoming>
      <bpmn:outgoing>P05_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P05_rec" name="Recoger y trasladar los productos disponibles">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f9</bpmn:incoming>
      <bpmn:outgoing>P05_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P05_ent" name="Entregar los productos en la mesa correspondiente">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f10</bpmn:incoming>
      <bpmn:outgoing>P05_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P05_fin" name="Lote entregado">
      <bpmn:documentation>Fuente: U1-7;U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f12</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:collaboration id="P05_collab">
    <bpmn:participant id="P05_restaurant" name="Restaurante Maderos" processRef="P05"/>
    <bpmn:participant id="Participant_1f4ybf9" name="Cliente / Comensal"/>
    <bpmn:messageFlow id="Flow_1asqrh8" name="Productos entregados en la mesa" sourceRef="P05_ent" targetRef="Participant_1f4ybf9"/>
  </bpmn:collaboration>
