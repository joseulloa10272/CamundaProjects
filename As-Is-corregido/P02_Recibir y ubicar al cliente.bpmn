    <bpmn:sequenceFlow id="P02_f13" sourceRef="P02_asig" targetRef="P02_acom"/>
    <bpmn:sequenceFlow id="P02_f12" sourceRef="P02_join" targetRef="P02_asig"/>
    <bpmn:sequenceFlow id="P02_f11" sourceRef="P02_contact" targetRef="P02_join"/>
    <bpmn:sequenceFlow id="P02_f10" sourceRef="P02_mesa" targetRef="P02_contact"/>
    <bpmn:sequenceFlow id="P02_f16" sourceRef="P02_ret" targetRef="P02_fr"/>
