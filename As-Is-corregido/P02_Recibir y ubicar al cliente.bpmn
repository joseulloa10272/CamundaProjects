  <bpmn:process id="P02" name="02 · Recepción y lista de espera" isExecutable="false">
    <bpmn:documentation>El salonero sustituye al capitán cuando no está disponible. La lista contiene información de contacto; se respeta el retiro del cliente. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P02_lanes">
      <bpmn:lane id="P02_lane_0" name="Capitán / salonero sustituto">
        <bpmn:flowNodeRef>P02_disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_inf</bpmn:flowNodeRef>
