    <bpmn:sequenceFlow id="P02_f7" sourceRef="P02_lista" targetRef="P02_ev"/>
    <bpmn:sequenceFlow id="P02_f6" name="No" sourceRef="P02_g" targetRef="P02_lista">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_f5" name="Sí" sourceRef="P02_g" targetRef="P02_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_f4" sourceRef="P02_inf" targetRef="P02_g"/>
    <bpmn:sequenceFlow id="P02_f1" sourceRef="P02_s" targetRef="P02_rec"/>
    <bpmn:sequenceFlow id="P02_f3" sourceRef="P02_disp" targetRef="P02_inf"/>
    <bpmn:sequenceFlow id="P02_f2" sourceRef="P02_rec" targetRef="P02_disp"/>
    <bpmn:endEvent id="P02_fin" name="Cliente ubicado">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_14o3rwg</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P02_acom" name="Acompañar al cliente">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f13</bpmn:incoming>
      <bpmn:outgoing>Flow_14o3rwg</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P02_asig" name="Asignar mesa">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f12</bpmn:incoming>
      <bpmn:outgoing>P02_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sendTask id="P02_contact" name="Contactar al cliente">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f10</bpmn:incoming>
      <bpmn:outgoing>P02_f11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="P02_join" name="Continuar ubicación">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f5</bpmn:incoming>
      <bpmn:incoming>P02_f11</bpmn:incoming>
      <bpmn:outgoing>P02_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="P02_mesa" name="Mesa disponible">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_04y6q2w</bpmn:incoming>
      <bpmn:outgoing>P02_f10</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">mesaDisponible</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="P02_fr" name="Atención finalizada sin mesa">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="P02_ret" name="Cliente comunica retiro">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f15</bpmn:incoming>
      <bpmn:outgoing>P02_f16</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_P02_ret"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="P02_ev" name="Esperar disponibilidad o retiro del cliente">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f7</bpmn:incoming>
      <bpmn:outgoing>P02_f15</bpmn:outgoing>
      <bpmn:outgoing>Flow_04y6q2w</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:task id="P02_lista" name="Registrar datos en lista de espera">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f6</bpmn:incoming>
      <bpmn:outgoing>P02_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P02_g" name="¿Hay mesa disponible?">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f4</bpmn:incoming>
      <bpmn:outgoing>P02_f5</bpmn:outgoing>
      <bpmn:outgoing>P02_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:startEvent id="P02_s" name="Cliente recibido para atención">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:outgoing>P02_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P02_inf" name="Informar al cliente sobre la disponibilidad">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f3</bpmn:incoming>
      <bpmn:outgoing>P02_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P02_rec" name="Recibir al cliente y consultar cantidad de personas">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f1</bpmn:incoming>
      <bpmn:outgoing>P02_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P02_disp" name="Verificar disponibilidad de mesas">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f2</bpmn:incoming>
      <bpmn:outgoing>P02_f3</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
