<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Maderos" targetNamespace="https://maderos.example/bpmn/PR-SERV-001" exporter="Camunda Modeler" exporterVersion="5.50.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_P03_cans" name="Cancelación total comunicada por el cliente"/>
  <bpmn:message id="Msg_P03_incs" name="Inconformidad durante el servicio"/>
  <bpmn:message id="Msg_P03_ads" name="Solicitud adicional"/>
  <bpmn:message id="Msg_P03_cuenta" name="Solicitud de cuenta recibida"/>
  <bpmn:message id="Msg_P02_ret" name="Cliente comunica retiro"/>
  <bpmn:escalation id="Esc_Cancelacion" name="Cancelación total" escalationCode="CANCELAR_SERVICIO"/>
  <bpmn:process id="P10" name="10 · Liberación y preparación de la mesa" isExecutable="false">
    <bpmn:documentation>El personal que retira también limpia y prepara la mesa; los saloneros realizan esas funciones cuando corresponde. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P10_lanes">
      <bpmn:lane id="P10_lane_0" name="Personal de apoyo / salonero">
        <bpmn:flowNodeRef>P10_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_lim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P10_s" name="Cliente se ha retirado">
      <bpmn:documentation>Fuente: U1-1;U2-9. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:outgoing>P10_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P10_ret" name="Retirar vajilla y utensilios">
      <bpmn:documentation>Fuente: U1-1;U2-9. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P10_f1</bpmn:incoming>
      <bpmn:outgoing>P10_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P10_lim" name="Limpiar mesa">
      <bpmn:documentation>Fuente: U1-1;U2-9. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P10_f2</bpmn:incoming>
      <bpmn:outgoing>P10_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P10_prep" name="Preparar mesa para nuevo servicio">
      <bpmn:documentation>Fuente: U1-1;U2-9. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P10_f3</bpmn:incoming>
      <bpmn:outgoing>P10_f4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P10_fin" name="Mesa disponible">
      <bpmn:documentation>Fuente: U1-1;U2-9. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P10_f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P10_f1" sourceRef="P10_s" targetRef="P10_ret"/>
    <bpmn:sequenceFlow id="P10_f2" sourceRef="P10_ret" targetRef="P10_lim"/>
    <bpmn:sequenceFlow id="P10_f3" sourceRef="P10_lim" targetRef="P10_prep"/>
    <bpmn:sequenceFlow id="P10_f4" sourceRef="P10_prep" targetRef="P10_fin"/>
  </bpmn:process>
  <bpmn:collaboration id="P10_collab">
    <bpmn:participant id="P10_restaurant" name="Restaurante Maderos" processRef="P10"/>
  </bpmn:collaboration>
  <bpmndi:BPMNDiagram id="P10_diagram" name="10 · Liberación y preparación de la mesa">
    <bpmndi:BPMNPlane id="P10_plane" bpmnElement="P10_collab">
      <bpmndi:BPMNShape id="P10_restaurant_di" bpmnElement="P10_restaurant" isHorizontal="true">
        <dc:Bounds x="150" y="100" width="1200" height="370"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_lane_0_di" bpmnElement="P10_lane_0" isHorizontal="true">
        <dc:Bounds x="180" y="100" width="1170" height="370"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_s_di" bpmnElement="P10_s">
        <dc:Bounds x="265" y="245" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="233" y="330" width="105" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_ret_di" bpmnElement="P10_ret">
        <dc:Bounds x="425" y="225" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_lim_di" bpmnElement="P10_lim">
        <dc:Bounds x="665" y="225" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_prep_di" bpmnElement="P10_prep">
        <dc:Bounds x="905" y="225" width="190" height="90"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_fin_di" bpmnElement="P10_fin">
        <dc:Bounds x="1225" y="245" width="40" height="40"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1205" y="330" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P10_f1_di" bpmnElement="P10_f1">
        <di:waypoint x="305" y="265"/>
        <di:waypoint x="425" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_f2_di" bpmnElement="P10_f2">
        <di:waypoint x="615" y="265"/>
        <di:waypoint x="665" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_f3_di" bpmnElement="P10_f3">
        <di:waypoint x="855" y="265"/>
        <di:waypoint x="905" y="265"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P10_f4_di" bpmnElement="P10_f4">
        <di:waypoint x="1095" y="265"/>
        <di:waypoint x="1225" y="265"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
