      <bpmn:outgoing>P06_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P06_fin" name="Pedido actualizado">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P06_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P06_fe" name="Producto eliminado">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P06_f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P06_can" name="Cancelación total solicitada">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_0anikju</bpmn:incoming>
      <bpmn:escalationEventDefinition escalationRef="Esc_Cancelacion"/>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P06_f4" name="Sustituir producto" sourceRef="P06_g" targetRef="P06_upd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sustituir</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P06_f7" name="Eliminar producto" sourceRef="P06_g" targetRef="P06_del">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Eliminar producto</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P06_f9" name="Cancelar todo" sourceRef="P06_g" targetRef="Activity_0ic4szm">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Cancelar todo</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0anikju" sourceRef="Activity_0ic4szm" targetRef="P06_can"/>
    <bpmn:sequenceFlow id="P06_f8" sourceRef="P06_del" targetRef="P06_fe"/>
    <bpmn:sequenceFlow id="P06_f5" sourceRef="P06_upd" targetRef="P06_llevar"/>
    <bpmn:sequenceFlow id="P06_f6" sourceRef="P06_llevar" targetRef="P06_fin"/>
    <bpmn:sequenceFlow id="Flow_0jksfvb" sourceRef="Event_18iwp8k" targetRef="P06_g"/>
    <bpmn:intermediateCatchEvent id="Event_18iwp8k" name="Decisión del cliente recibida">
      <bpmn:incoming>P06_f3</bpmn:incoming>
      <bpmn:outgoing>Flow_0jksfvb</bpmn:outgoing>
