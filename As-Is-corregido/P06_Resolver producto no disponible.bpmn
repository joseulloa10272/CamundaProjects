  <bpmn:escalation id="Esc_Cancelacion" name="Cancelación total" escalationCode="CANCELAR_SERVICIO"/>
  <bpmn:process id="P06" name="06 · Faltante y elección del cliente" isExecutable="false">
    <bpmn:documentation>Las modificaciones se anotan en papel y se llevan a cocina. No se actualiza un POS ni se imprime una comanda. La cancelación total conserva el consumo realizado. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P06_lanes">
      <bpmn:lane id="P06_lane_0" name="Personal de cocina">
        <bpmn:flowNodeRef>P06_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_inf</bpmn:flowNodeRef>
        <bpmn:childLaneSet id="LaneSet_0ljy5mp"/>
      </bpmn:lane>
      <bpmn:lane id="Lane_0jjul0o" name="Salonero">
        <bpmn:flowNodeRef>P06_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0ic4szm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_fe</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_18iwp8k</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>P06_upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_llevar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P06_fin</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="P06_f1" sourceRef="P06_s" targetRef="P06_inf"/>
    <bpmn:sequenceFlow id="P06_f2" sourceRef="P06_inf" targetRef="P06_alt"/>
    <bpmn:sequenceFlow id="P06_f3" sourceRef="P06_alt" targetRef="Event_18iwp8k"/>
    <bpmn:startEvent id="P06_s" name="Producto no disponible identificado">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:outgoing>P06_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P06_inf" name="Informar al salonero cuando un producto no esté disponible">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P06_f1</bpmn:incoming>
      <bpmn:outgoing>P06_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P06_alt" name="Solicitar al cliente una alternativa para el producto faltante">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P06_f2</bpmn:incoming>
      <bpmn:outgoing>P06_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P06_g" name="¿Qué decide el cliente?">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_0jksfvb</bpmn:incoming>
      <bpmn:outgoing>P06_f4</bpmn:outgoing>
      <bpmn:outgoing>P06_f7</bpmn:outgoing>
      <bpmn:outgoing>P06_f9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_0ic4szm" name="Registrar la cancelación del pedido">
      <bpmn:incoming>P06_f9</bpmn:incoming>
      <bpmn:outgoing>Flow_0anikju</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P06_del" name="Eliminar producto del pedido escrito">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P06_f7</bpmn:incoming>
      <bpmn:outgoing>P06_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P06_upd" name="Actualizar el pedido escrito">
