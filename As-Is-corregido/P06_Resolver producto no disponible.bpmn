      <bpmn:outgoing>P06_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P06_llevar" name="Llevar el pedido modificado a cocina">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
