<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Maderos" targetNamespace="https://maderos.example/bpmn/PR-SERV-001" exporter="Camunda Web Modeler" exporterVersion="27cc6be" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_P03_cans" name="Cancelación total comunicada por el cliente"/>
  <bpmn:message id="Msg_P03_incs" name="Inconformidad durante el servicio"/>
  <bpmn:message id="Msg_P03_ads" name="Solicitud adicional"/>
  <bpmn:message id="Msg_P03_cuenta" name="Solicitud de cuenta recibida"/>
  <bpmn:message id="Msg_P02_ret" name="Cliente comunica retiro"/>
  <bpmn:escalation id="Esc_Cancelacion" name="Cancelación total" escalationCode="CANCELAR_SERVICIO"/>
  <bpmn:process id="P07" name="07 · Correcciones e inconformidades" isExecutable="false">
    <bpmn:documentation>El salonero resuelve primero con el cliente. Solo se escala a gerencia cuando no logra resolverlo. Una corrección normal no requiere autorización; el acuerdo gerencial puede incluir descuento, cortesía o exención. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P07_lanes">
      <bpmn:lane id="P07_lane_1" name="Gerente">
        <bpmn:flowNodeRef>P07_ger</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P07_lane_0" name="Salonero">
        <bpmn:flowNodeRef>P07_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_aten</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_cambio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_merge_explicit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_upd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_llevar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_prep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P07_fin</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>Activity_1usrpcw</bpmn:flowNodeRef>
        </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:exclusiveGateway id="P07_g" name="¿La inconformidad se resuelve por el salonero?">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f2</bpmn:incoming>
      <bpmn:outgoing>P07_f3</bpmn:outgoing>
      <bpmn:outgoing>P07_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P07_aten" name="Recibir reportes de errores o inconformidades">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f1</bpmn:incoming>
      <bpmn:outgoing>P07_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:startEvent id="P07_s" name="Inconformidad recibida">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:outgoing>P07_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="P07_cambio" name="¿La solución requiere corregir el pedido?">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f6</bpmn:incoming>
      <bpmn:outgoing>P07_f8</bpmn:outgoing>
      <bpmn:outgoing>P07_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P07_f2" sourceRef="P07_aten" targetRef="P07_g"/>
    <bpmn:sequenceFlow id="P07_f3" name="Sí" sourceRef="P07_g" targetRef="P07_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_f4" name="No" sourceRef="P07_g" targetRef="Activity_1usrpcw">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_f1" sourceRef="P07_s" targetRef="P07_aten"/>
    <bpmn:sequenceFlow id="P07_f5" sourceRef="P07_ger" targetRef="P07_join"/>
    <bpmn:sequenceFlow id="P07_f6" sourceRef="P07_join" targetRef="P07_cambio"/>
    <bpmn:sequenceFlow id="P07_f8" name="Sí" sourceRef="P07_cambio" targetRef="P07_upd">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_f9" sourceRef="P07_upd" targetRef="P07_llevar"/>
    <bpmn:sequenceFlow id="P07_f10" sourceRef="P07_llevar" targetRef="P07_prep"/>
    <bpmn:sequenceFlow id="P07_f11" sourceRef="P07_prep" targetRef="P07_merge_explicit"/>
    <bpmn:sequenceFlow id="P07_f7" name="No" sourceRef="P07_cambio" targetRef="P07_merge_explicit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_f12" sourceRef="P07_merge_explicit" targetRef="P07_fin"/>
    <bpmn:task id="Activity_1usrpcw" name="Escalar la inconformidad al gerente">
      <bpmn:incoming>P07_f4</bpmn:incoming>
      <bpmn:outgoing>Flow_1ipgrrh</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1ipgrrh" sourceRef="Activity_1usrpcw" targetRef="P07_ger"/>
    <bpmn:exclusiveGateway id="P07_join">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f3</bpmn:incoming>
      <bpmn:incoming>P07_f5</bpmn:incoming>
      <bpmn:outgoing>P07_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P07_merge_explicit" name="Continuar recorrido">
      <bpmn:documentation>Fuente: Normalización BPMN de rutas exclusivas confirmadas. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f11</bpmn:incoming>
      <bpmn:incoming>P07_f7</bpmn:incoming>
      <bpmn:outgoing>P07_f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P07_upd" name="Anotar corrección en papel">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f8</bpmn:incoming>
      <bpmn:outgoing>P07_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P07_llevar" name="Llevar corrección a cocina">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f9</bpmn:incoming>
      <bpmn:outgoing>P07_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="P07_prep" name="Preparar y entregar productos" calledElement="P05">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:calledElement processId="P05"/>
      </bpmn:extensionElements>
      <bpmn:incoming>P07_f10</bpmn:incoming>
      <bpmn:outgoing>P07_f11</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:documentation>Una instancia por lote de entrega real, sin imponer tamaño ni espera conjunta de toda la mesa. Abstracción descriptiva pendiente de revisión operacional.</bpmn:documentation>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
    <bpmn:endEvent id="P07_fin" name="Inconformidad atendida">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P07_ger" name="Acordar una solución con el cliente">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_1ipgrrh</bpmn:incoming>
      <bpmn:outgoing>P07_f5</bpmn:outgoing>
    </bpmn:task>
  </bpmn:process>
  <bpmn:collaboration id="P07_collab">
    <bpmn:participant id="P07_restaurant" name="Restaurante Maderos" processRef="P07"/>
