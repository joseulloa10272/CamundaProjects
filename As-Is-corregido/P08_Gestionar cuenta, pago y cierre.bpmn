<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Maderos" targetNamespace="https://maderos.example/bpmn/PR-SERV-001" exporter="Camunda Web Modeler" exporterVersion="27cc6be" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Msg_P03_cans" name="Cancelación total comunicada por el cliente"/>
  <bpmn:message id="Msg_P03_incs" name="Inconformidad durante el servicio"/>
  <bpmn:message id="Msg_P03_ads" name="Solicitud adicional"/>
  <bpmn:message id="Msg_P03_cuenta" name="Solicitud de cuenta recibida"/>
  <bpmn:message id="Msg_P02_ret" name="Cliente comunica retiro"/>
  <bpmn:escalation id="Esc_Cancelacion" name="Cancelación total" escalationCode="CANCELAR_SERVICIO"/>
  <bpmn:process id="P08" name="08 · Revisión de cuenta, factura y cierre" isExecutable="false">
    <bpmn:documentation>El salonero genera previamente la cuenta. Caja corrige diferencias con respaldo de la información de cocina. La factura se emite en SuFacturaFácil después de completar el pago; no se presume integración con Aldelo. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P08_lanes">
      <bpmn:lane id="P08_lane_0" name="Personal de caja">
        <bpmn:flowNodeRef>P08_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1wz7tyu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0qhyoc3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_14bt4lz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fin</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P08_s" name="Solicitud de cuenta recibida">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:outgoing>P08_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="P08_f3" name="Sí" sourceRef="P08_g" targetRef="P08_corr">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12ioj8t" sourceRef="Activity_1wz7tyu" targetRef="P08_g"/>
    <bpmn:sequenceFlow id="Flow_0rzhugl" sourceRef="P08_g" targetRef="P08_pago" name="No"/>
    <bpmn:sequenceFlow id="P08_f2" sourceRef="P08_rev" targetRef="Activity_1wz7tyu"/>
    <bpmn:sequenceFlow id="P08_f1" sourceRef="P08_s" targetRef="P08_rev"/>
    <bpmn:sequenceFlow id="P08_f8" sourceRef="P08_pago" targetRef="P08_fact"/>
    <bpmn:sequenceFlow id="P08_f9" sourceRef="P08_fact" targetRef="Activity_0qhyoc3"/>
    <bpmn:sequenceFlow id="Flow_1rijcr1" sourceRef="Activity_0qhyoc3" targetRef="P08_close"/>
    <bpmn:sequenceFlow id="Flow_03dfylq" sourceRef="P08_close" targetRef="Activity_14bt4lz"/>
    <bpmn:sequenceFlow id="Flow_0a8q3hv" sourceRef="Activity_14bt4lz" targetRef="P08_fin"/>
    <bpmn:sequenceFlow id="Flow_0bi9vhe" sourceRef="P08_corr" targetRef="P08_pago"/>
    <bpmn:task id="P08_rev" name="Preparar y verificar la cuenta según los productos consumidos">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P08_f1</bpmn:incoming>
      <bpmn:outgoing>P08_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_1wz7tyu" name="Presentar la cuenta al cliente">
      <bpmn:incoming>P08_f2</bpmn:incoming>
      <bpmn:outgoing>Flow_12ioj8t</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P08_corr" name="Corregir cuenta según consumo">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P08_f3</bpmn:incoming>
      <bpmn:outgoing>Flow_0bi9vhe</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P08_g" name="¿Hay diferencias en la cuenta?" default="Flow_0rzhugl">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_12ioj8t</bpmn:incoming>
      <bpmn:outgoing>P08_f3</bpmn:outgoing>
      <bpmn:outgoing>Flow_0rzhugl</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="P08_pago" name="Procesar pago y medios alternativos" calledElement="P09">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_0rzhugl</bpmn:incoming>
      <bpmn:incoming>Flow_0bi9vhe</bpmn:incoming>
      <bpmn:outgoing>P08_f8</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="P08_fact" name="Emitir factura en SuFacturaFácil">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>P08_f8</bpmn:incoming>
      <bpmn:outgoing>P08_f9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0qhyoc3" name="Entregar comprobante al cliente">
      <bpmn:incoming>P08_f9</bpmn:incoming>
      <bpmn:outgoing>Flow_1rijcr1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P08_close" name="Cerrar cuenta">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_1rijcr1</bpmn:incoming>
      <bpmn:outgoing>Flow_03dfylq</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_14bt4lz" name="Despedir al cliente">
      <bpmn:incoming>Flow_03dfylq</bpmn:incoming>
      <bpmn:outgoing>Flow_0a8q3hv</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P08_fin" name="Cuenta liquidada">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación final del conjunto pendiente.</bpmn:documentation>
      <bpmn:incoming>Flow_0a8q3hv</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
