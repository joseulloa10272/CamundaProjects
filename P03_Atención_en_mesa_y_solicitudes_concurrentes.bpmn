      <bpmn:outgoing>P07_f11</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:documentation>Una instancia por lote de entrega real, sin imponer tamaño ni espera conjunta de toda la mesa. Abstracción descriptiva pendiente de revisión operacional.</bpmn:documentation>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:callActivity>
