    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_f4" name="No" sourceRef="P07_g" targetRef="P07_ger">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_f5" sourceRef="P07_ger" targetRef="P07_join" />
    <bpmn:sequenceFlow id="P07_f6" sourceRef="P07_join" targetRef="P07_cambio" />
    <bpmn:sequenceFlow id="P07_f7" name="No" sourceRef="P07_cambio" targetRef="P07_merge_explicit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P07_f8" name="Sí" sourceRef="P07_cambio" targetRef="P07_upd">
