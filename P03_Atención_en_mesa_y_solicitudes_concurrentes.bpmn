      <bpmn:outgoing>P08_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P08_corr" name="Corregir cuenta según consumo">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P08_f3</bpmn:incoming>
      <bpmn:outgoing>P08_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P08_join" name="Cuenta revisada">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P08_f4</bpmn:incoming>
      <bpmn:incoming>P08_f5</bpmn:incoming>
      <bpmn:outgoing>P08_f6</bpmn:outgoing>
