<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Maderos" targetNamespace="https://maderos.example/bpmn/PR-SERV-001" exporter="Codex - modelo descriptivo" exporterVersion="0.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:escalation id="Esc_Cancelacion" name="Cancelación total" escalationCode="CANCELAR_SERVICIO" />
  <bpmn:process id="P01" name="01 · Servicio al comensal · Vista general" isExecutable="false">
    <bpmn:documentation>Una instancia corresponde a la visita de un grupo. Los detalles de cada actividad llamada se desarrollan en las láminas 02-10. Modelo descriptivo no ejecutable; versión de revisión v0.2. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:startEvent id="P01_s" name="Cliente llega">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:outgoing>P01_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:callActivity id="P01_r" name="Recibir y ubicar al cliente" calledElement="P02">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f1</bpmn:incoming>
      <bpmn:outgoing>P01_f2</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="P01_g" name="¿Cliente ubicado?">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f2</bpmn:incoming>
      <bpmn:outgoing>P01_f3</bpmn:outgoing>
      <bpmn:outgoing>P01_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="P01_svc" name="Atender servicio en mesa" calledElement="P03">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f3</bpmn:incoming>
      <bpmn:outgoing>P01_f5</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="P01_cuenta" name="Generar y verificar cuenta">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f5</bpmn:incoming>
      <bpmn:outgoing>P01_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="P01_caja" name="Facturar y cobrar consumo" calledElement="P08">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f6</bpmn:incoming>
      <bpmn:outgoing>P01_f7</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:task id="P01_desp" name="Despedir al cliente">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f7</bpmn:incoming>
      <bpmn:outgoing>P01_f8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:callActivity id="P01_mesa" name="Acondicionar mesa" calledElement="P10">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f8</bpmn:incoming>
      <bpmn:outgoing>P01_f9</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="P01_fin" name="Servicio finalizado; mesa preparada">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="P01_retiro" name="Cliente retirado durante la espera">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P01_f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P01_f1" sourceRef="P01_s" targetRef="P01_r" />
    <bpmn:sequenceFlow id="P01_f2" sourceRef="P01_r" targetRef="P01_g" />
    <bpmn:sequenceFlow id="P01_f3" name="Sí" sourceRef="P01_g" targetRef="P01_svc">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_f4" name="No" sourceRef="P01_g" targetRef="P01_retiro">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P01_f5" sourceRef="P01_svc" targetRef="P01_cuenta" />
    <bpmn:sequenceFlow id="P01_f6" sourceRef="P01_cuenta" targetRef="P01_caja" />
    <bpmn:sequenceFlow id="P01_f7" sourceRef="P01_caja" targetRef="P01_desp" />
    <bpmn:sequenceFlow id="P01_f8" sourceRef="P01_desp" targetRef="P01_mesa" />
    <bpmn:sequenceFlow id="P01_f9" sourceRef="P01_mesa" targetRef="P01_fin" />
  </bpmn:process>
  <bpmn:collaboration id="P01_collab">
    <bpmn:participant id="P01_restaurant" name="Restaurante Maderos" processRef="P01" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_P02_ret" name="Cliente comunica retiro" />
  <bpmn:process id="P02" name="02 · Recepción y lista de espera" isExecutable="false">
    <bpmn:documentation>El salonero sustituye al capitán cuando no está disponible. La lista contiene información de contacto; se respeta el retiro del cliente. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P02_lanes">
      <bpmn:lane id="P02_lane_0" name="Capitán / salonero sustituto">
        <bpmn:flowNodeRef>P02_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_disp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_lista</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_cap</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_ev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_mesa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_contact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_asig</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_acom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_ret</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P02_fr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P02_s" name="Cliente recibido para atención">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:outgoing>P02_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P02_rec" name="Recibir al cliente">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f1</bpmn:incoming>
      <bpmn:outgoing>P02_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P02_disp" name="Verificar disponibilidad de mesas">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f2</bpmn:incoming>
      <bpmn:outgoing>P02_f3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P02_g" name="¿Hay mesa disponible?">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f3</bpmn:incoming>
      <bpmn:outgoing>P02_f4</bpmn:outgoing>
      <bpmn:outgoing>P02_f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P02_lista" name="Registrar datos en lista de espera">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f5</bpmn:incoming>
      <bpmn:outgoing>P02_f6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P02_cap" name="Informar al capitán">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f6</bpmn:incoming>
      <bpmn:outgoing>P02_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:eventBasedGateway id="P02_ev" name="Esperar un acontecimiento">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f7</bpmn:incoming>
      <bpmn:outgoing>P02_f8</bpmn:outgoing>
      <bpmn:outgoing>P02_f14</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="P02_mesa" name="Mesa disponible">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f8</bpmn:incoming>
      <bpmn:outgoing>P02_f9</bpmn:outgoing>
      <bpmn:conditionalEventDefinition>
        <bpmn:condition xsi:type="bpmn:tFormalExpression">mesaDisponible</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="P02_contact" name="Contactar al cliente">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f9</bpmn:incoming>
      <bpmn:outgoing>P02_f10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P02_join" name="Continuar ubicación">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f4</bpmn:incoming>
      <bpmn:incoming>P02_f10</bpmn:incoming>
      <bpmn:outgoing>P02_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P02_asig" name="Asignar mesa">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f11</bpmn:incoming>
      <bpmn:outgoing>P02_f12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P02_acom" name="Acompañar al cliente">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f12</bpmn:incoming>
      <bpmn:outgoing>P02_f13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P02_fin" name="Cliente ubicado">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="P02_ret" name="Cliente comunica retiro">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f14</bpmn:incoming>
      <bpmn:outgoing>P02_f15</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Msg_P02_ret" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="P02_fr" name="Atención finalizada sin mesa">
      <bpmn:documentation>Fuente: U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P02_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="P02_f1" sourceRef="P02_s" targetRef="P02_rec" />
    <bpmn:sequenceFlow id="P02_f2" sourceRef="P02_rec" targetRef="P02_disp" />
    <bpmn:sequenceFlow id="P02_f3" sourceRef="P02_disp" targetRef="P02_g" />
    <bpmn:sequenceFlow id="P02_f4" name="Sí" sourceRef="P02_g" targetRef="P02_join">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_f5" name="No" sourceRef="P02_g" targetRef="P02_lista">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">No</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="P02_f6" sourceRef="P02_lista" targetRef="P02_cap" />
    <bpmn:sequenceFlow id="P02_f7" sourceRef="P02_cap" targetRef="P02_ev" />
    <bpmn:sequenceFlow id="P02_f8" sourceRef="P02_ev" targetRef="P02_mesa" />
    <bpmn:sequenceFlow id="P02_f9" sourceRef="P02_mesa" targetRef="P02_contact" />
    <bpmn:sequenceFlow id="P02_f10" sourceRef="P02_contact" targetRef="P02_join" />
    <bpmn:sequenceFlow id="P02_f11" sourceRef="P02_join" targetRef="P02_asig" />
    <bpmn:sequenceFlow id="P02_f12" sourceRef="P02_asig" targetRef="P02_acom" />
    <bpmn:sequenceFlow id="P02_f13" sourceRef="P02_acom" targetRef="P02_fin" />
    <bpmn:sequenceFlow id="P02_f14" sourceRef="P02_ev" targetRef="P02_ret" />
    <bpmn:sequenceFlow id="P02_f15" sourceRef="P02_ret" targetRef="P02_fr" />
  </bpmn:process>
  <bpmn:collaboration id="P02_collab">
    <bpmn:participant id="P02_restaurant" name="Restaurante Maderos" processRef="P02" />
    <bpmn:participant id="P02_client" name="Cliente / comensal" />
    <bpmn:messageFlow id="P02_msg_0" name="Decisión de retirarse" sourceRef="P02_client" targetRef="P02_ret" />
    <bpmn:messageFlow id="P02_msg_1" name="Aviso de mesa disponible" sourceRef="P02_contact" targetRef="P02_client" />
  </bpmn:collaboration>
  <bpmn:message id="Msg_P03_cuenta" name="Solicitud de cuenta recibida" />
  <bpmn:message id="Msg_P03_ads" name="Solicitud adicional" />
  <bpmn:message id="Msg_P03_incs" name="Inconformidad durante el servicio" />
  <bpmn:message id="Msg_P03_cans" name="Cancelación total comunicada por el cliente" />
  <bpmn:process id="P03" name="03 · Atención en mesa y solicitudes concurrentes" isExecutable="false">
    <bpmn:documentation>Los subprocesos de evento de adicionales y reclamos no interrumpen la atención. Una cancelación total sí interrumpe el servicio pendiente. El final normal espera a las instancias activas antes de retornar al proceso general. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P03_lanes">
      <bpmn:lane id="P03_lane_0" name="Salonero y responsables de módulos llamados">
        <bpmn:flowNodeRef>P03_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_consult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_pedido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_cuenta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_group_ad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_group_inc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_group_sat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_group_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P03_group_esc</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:subProcess id="P03_group_ad" name="Solicitud adicional" triggeredByEvent="true">
      <bpmn:startEvent id="P03_ads" name="Solicitud adicional" isInterrupting="false">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:outgoing>P03_f9</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_P03_ads" />
      </bpmn:startEvent>
      <bpmn:callActivity id="P03_adt" name="Atender pedido adicional" calledElement="P04">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:incoming>P03_f9</bpmn:incoming>
        <bpmn:outgoing>P03_f10</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="P03_ade" name="Atención complementaria finalizada">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:incoming>P03_f10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P03_f9" sourceRef="P03_ads" targetRef="P03_adt" />
      <bpmn:sequenceFlow id="P03_f10" sourceRef="P03_adt" targetRef="P03_ade" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P03_group_inc" name="Inconformidad durante el servicio" triggeredByEvent="true">
      <bpmn:startEvent id="P03_incs" name="Inconformidad durante el servicio" isInterrupting="false">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:outgoing>P03_f11</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_P03_incs" />
      </bpmn:startEvent>
      <bpmn:callActivity id="P03_inct" name="Resolver inconformidad" calledElement="P07">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:incoming>P03_f11</bpmn:incoming>
        <bpmn:outgoing>P03_f12</bpmn:outgoing>
      </bpmn:callActivity>
      <bpmn:endEvent id="P03_ince" name="Atención complementaria finalizada">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:incoming>P03_f12</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P03_f11" sourceRef="P03_incs" targetRef="P03_inct" />
      <bpmn:sequenceFlow id="P03_f12" sourceRef="P03_inct" targetRef="P03_ince" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P03_group_sat" name="Consulta al retirar utensilios" triggeredByEvent="true">
      <bpmn:startEvent id="P03_sats" name="Consulta al retirar utensilios" isInterrupting="false">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:outgoing>P03_f13</bpmn:outgoing>
        <bpmn:conditionalEventDefinition>
          <bpmn:condition xsi:type="bpmn:tFormalExpression">retiroUtensiliosDuranteServicio</bpmn:condition>
        </bpmn:conditionalEventDefinition>
      </bpmn:startEvent>
      <bpmn:task id="P03_satt" name="Consultar satisfacción">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:incoming>P03_f13</bpmn:incoming>
        <bpmn:outgoing>P03_f14</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="P03_sate" name="Atención complementaria finalizada">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:incoming>P03_f14</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="P03_f13" sourceRef="P03_sats" targetRef="P03_satt" />
      <bpmn:sequenceFlow id="P03_f14" sourceRef="P03_satt" targetRef="P03_sate" />
    </bpmn:subProcess>
    <bpmn:subProcess id="P03_group_can" name="Cancelación total comunicada por el cliente" triggeredByEvent="true">
      <bpmn:startEvent id="P03_cans" name="Cancelación total comunicada por el cliente">
        <bpmn:documentation>Fuente: U1;U2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
        <bpmn:outgoing>P03_f15</bpmn:outgoing>
        <bpmn:messageEventDefinition messageRef="Msg_P03_cans" />
      </bpmn:startEvent>
      <bpmn:task id="P03_cant" name="Ajustar cuenta a lo consumido">
