      <bpmn:incoming>P07_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="P07_merge_explicit" name="Continuar recorrido">
      <bpmn:documentation>Fuente: Normalización BPMN de rutas exclusivas confirmadas. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
