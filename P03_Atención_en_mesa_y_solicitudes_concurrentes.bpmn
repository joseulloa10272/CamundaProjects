      <bpmn:outgoing>P09_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P09_confirm" name="Registrar confirmación del pago">
      <bpmn:documentation>Fuente: U2-8;U4. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P09_f4</bpmn:incoming>
      <bpmn:outgoing>P09_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="P09_fin" name="Pago confirmado">
      <bpmn:documentation>Fuente: U2-8;U4. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P09_f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="P09_info" name="Informar pago rechazado">
      <bpmn:documentation>Fuente: U2-8;U4. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P09_f6</bpmn:incoming>
      <bpmn:outgoing>P09_f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:receiveTask id="P09_alt" name="Recibir otro intento o medio alternativo">
