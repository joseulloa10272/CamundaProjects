      <bpmn:incoming>P07_f4</bpmn:incoming>
      <bpmn:outgoing>P07_f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P07_join" name="Continuar con la solución">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f3</bpmn:incoming>
      <bpmn:incoming>P07_f5</bpmn:incoming>
      <bpmn:outgoing>P07_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P07_cambio" name="¿Requiere corregir el pedido?">
