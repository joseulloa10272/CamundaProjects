      <bpmn:outgoing>P06_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="P06_alt" name="Solicitar alternativa al cliente">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U2-4;U2-5. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
