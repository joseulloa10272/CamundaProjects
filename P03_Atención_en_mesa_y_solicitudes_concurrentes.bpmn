        <bpmn:flowNodeRef>P08_rev</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_g</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_corr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_saldo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_pago</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fact</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_ent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_zero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_fz</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P08_merge_explicit</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P08_s" name="Cuenta presentada">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:outgoing>P08_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P08_rev" name="Revisar cuenta y consultar satisfacción">
      <bpmn:documentation>Fuente: U1-16;U2-6;U4. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P08_f1</bpmn:incoming>
      <bpmn:outgoing>P08_f2</bpmn:outgoing>
    </bpmn:task>
