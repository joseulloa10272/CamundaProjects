      <bpmn:outgoing>P05_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:inclusiveGateway id="P05_split" name="Preparación según contenido">
      <bpmn:documentation>Fuente: U1-11;U1-12;U2-2. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P05_f1</bpmn:incoming>
      <bpmn:outgoing>P05_f2</bpmn:outgoing>
