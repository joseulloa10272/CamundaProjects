      <bpmn:incoming>P07_f6</bpmn:incoming>
      <bpmn:outgoing>P07_f7</bpmn:outgoing>
      <bpmn:outgoing>P07_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="P07_upd" name="Anotar corrección en papel">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
