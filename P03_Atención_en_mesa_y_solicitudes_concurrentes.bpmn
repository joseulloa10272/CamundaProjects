      <bpmn:outgoing>P07_f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="P07_aten" name="Atender inconformidad con el cliente">
      <bpmn:documentation>Fuente: Aclaración manual 04/10/2026;U1-14;U2-5;U2-6. Información aportada por usuario o perfil; validación del modelo completo pendiente.</bpmn:documentation>
      <bpmn:incoming>P07_f1</bpmn:incoming>
      <bpmn:outgoing>P07_f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="P07_g" name="¿Se resuelve en salón?">
