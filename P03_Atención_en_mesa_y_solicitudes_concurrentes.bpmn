    <bpmn:participant id="P07_restaurant" name="Restaurante Maderos" processRef="P07" />
  </bpmn:collaboration>
  <bpmn:process id="P08" name="08 · Revisión de cuenta, factura y cierre" isExecutable="false">
    <bpmn:documentation>El salonero genera previamente la cuenta. Caja corrige diferencias con respaldo de la información de cocina. La factura se emite en Sufacturafácil después de completar el pago; no se presume integración con Aldelo. Estado: revisión, pendiente de validación con persona del proceso.</bpmn:documentation>
    <bpmn:laneSet id="P08_lanes">
      <bpmn:lane id="P08_lane_0" name="Personal de caja">
