    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P07_f1" sourceRef="P07_s" targetRef="P07_aten" />
    <bpmn:sequenceFlow id="P07_f2" sourceRef="P07_aten" targetRef="P07_g" />
