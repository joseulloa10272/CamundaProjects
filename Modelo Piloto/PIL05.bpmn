      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_manual" bpmnElement="PIL05_manual">
        <dc:Bounds x="912.5" y="376.0" width="175" height="74"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_diff" bpmnElement="PIL05_diff">
        <dc:Bounds x="1190.0" y="388.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_resolve" bpmnElement="PIL05_resolve">
        <dc:Bounds x="1342.5" y="226.0" width="175" height="74"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_balance" bpmnElement="PIL05_balance">
        <dc:Bounds x="1620.0" y="388.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_zero" bpmnElement="PIL05_zero">
        <dc:Bounds x="1842.0" y="395.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_pay" bpmnElement="PIL05_pay">
        <dc:Bounds x="1987.5" y="376.0" width="175" height="74"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_close" bpmnElement="PIL05_close">
        <dc:Bounds x="2202.5" y="376.0" width="175" height="74"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_e" bpmnElement="PIL05_e">
        <dc:Bounds x="2487.0" y="395.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
