<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_PIL05" targetNamespace="https://maderos.example/bpmn/piloto">
  <bpmn:process id="PIL05" name="Conciliar cuenta, pago y cierre" isExecutable="false">
    <bpmn:documentation>La consulta digital es opcional; la conciliación con el procedimiento vigente es obligatoria. Verificar cambios, anulaciones y adicionales, y evitar doble cobro por sustituciones.</bpmn:documentation>
    <bpmn:laneSet id="PIL05_roles">
      <bpmn:lane id="PIL05_rol1" name="Salonero">
        <bpmn:flowNodeRef>PIL05_handoff</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL05_rol3" name="Capitán / Gerencia">
        <bpmn:flowNodeRef>PIL05_resolve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL05_rol4" name="Caja">
        <bpmn:flowNodeRef>PIL05_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_enabled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_manual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_diff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_balance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_zero</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL05_e</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PIL05_s" name="Solicitud de cuenta o cierre por cancelación">
      <bpmn:outgoing>PIL05_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PIL05_handoff" name="Trasladar resumen del consumo y operaciones resueltas">
      <bpmn:incoming>PIL05_f0</bpmn:incoming>
      <bpmn:outgoing>PIL05_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL05_enabled" name="¿Consulta digital habilitada?" default="PIL05_f3">
      <bpmn:incoming>PIL05_f1</bpmn:incoming>
      <bpmn:outgoing>PIL05_f2</bpmn:outgoing>
      <bpmn:outgoing>PIL05_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PIL05_check" name="Consultar detalle digital del consumo">
      <bpmn:incoming>PIL05_f2</bpmn:incoming>
      <bpmn:outgoing>PIL05_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PIL05_manual" name="Conciliar siempre con el procedimiento vigente de caja">
      <bpmn:incoming>PIL05_f3</bpmn:incoming>
      <bpmn:incoming>PIL05_f4</bpmn:incoming>
      <bpmn:incoming>PIL05_f7</bpmn:incoming>
      <bpmn:outgoing>PIL05_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL05_diff" name="¿Hay diferencias?" default="PIL05_f8">
      <bpmn:incoming>PIL05_f5</bpmn:incoming>
      <bpmn:outgoing>PIL05_f6</bpmn:outgoing>
      <bpmn:outgoing>PIL05_f8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PIL05_resolve" name="Resolver diferencia y confirmar cargos autorizados">
      <bpmn:incoming>PIL05_f6</bpmn:incoming>
      <bpmn:outgoing>PIL05_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL05_balance" name="¿Existe saldo por cobrar?" default="PIL05_f10">
      <bpmn:incoming>PIL05_f8</bpmn:incoming>
      <bpmn:outgoing>PIL05_f9</bpmn:outgoing>
      <bpmn:outgoing>PIL05_f10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PIL05_zero" name="Cerrar servicio sin cobro">
      <bpmn:incoming>PIL05_f10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="PIL05_pay" name="Procesar pago y medios alternativos" calledElement="PIL08">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PIL08"/>
      </bpmn:extensionElements>
      <bpmn:incoming>PIL05_f9</bpmn:incoming>
      <bpmn:outgoing>PIL05_f11</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="PIL05_close" name="Facturar en SuFacturaFácil y cerrar la cuenta">
      <bpmn:incoming>PIL05_f11</bpmn:incoming>
      <bpmn:outgoing>PIL05_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PIL05_e" name="Cuenta liquidada">
      <bpmn:incoming>PIL05_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PIL05_f0" sourceRef="PIL05_s" targetRef="PIL05_handoff"/>
    <bpmn:sequenceFlow id="PIL05_f1" sourceRef="PIL05_handoff" targetRef="PIL05_enabled"/>
    <bpmn:sequenceFlow id="PIL05_f2" sourceRef="PIL05_enabled" targetRef="PIL05_check" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL05_f3" sourceRef="PIL05_enabled" targetRef="PIL05_manual" name="No"/>
    <bpmn:sequenceFlow id="PIL05_f4" sourceRef="PIL05_check" targetRef="PIL05_manual"/>
    <bpmn:sequenceFlow id="PIL05_f5" sourceRef="PIL05_manual" targetRef="PIL05_diff"/>
    <bpmn:sequenceFlow id="PIL05_f6" sourceRef="PIL05_diff" targetRef="PIL05_resolve" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL05_f7" sourceRef="PIL05_resolve" targetRef="PIL05_manual"/>
    <bpmn:sequenceFlow id="PIL05_f8" sourceRef="PIL05_diff" targetRef="PIL05_balance" name="No"/>
    <bpmn:sequenceFlow id="PIL05_f9" sourceRef="PIL05_balance" targetRef="PIL05_pay" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL05_f10" sourceRef="PIL05_balance" targetRef="PIL05_zero" name="No"/>
    <bpmn:sequenceFlow id="PIL05_f11" sourceRef="PIL05_pay" targetRef="PIL05_close"/>
    <bpmn:sequenceFlow id="PIL05_f12" sourceRef="PIL05_close" targetRef="PIL05_e"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="DG_PIL05">
    <bpmndi:BPMNPlane id="PL_PIL05" bpmnElement="PIL05">
      <bpmndi:BPMNShape id="DI_PIL05_rol1" bpmnElement="PIL05_rol1" isHorizontal="true">
        <dc:Bounds x="30" y="40" width="2610" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_rol3" bpmnElement="PIL05_rol3" isHorizontal="true">
        <dc:Bounds x="30" y="190" width="2610" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_rol4" bpmnElement="PIL05_rol4" isHorizontal="true">
        <dc:Bounds x="30" y="340" width="2610" height="150"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_s" bpmnElement="PIL05_s">
        <dc:Bounds x="122.0" y="395.0" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL05_handoff" bpmnElement="PIL05_handoff">
