        <di:waypoint x="1342.5" y="263"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1247.625" y="393.0" width="36" height="16"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL05_f7" bpmnElement="PIL05_f7">
        <di:waypoint x="1430" y="226.0"/>
        <di:waypoint x="1430" y="195"/>
        <di:waypoint x="1000" y="195"/>
        <di:waypoint x="1000" y="376.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL05_f8" bpmnElement="PIL05_f8">
        <di:waypoint x="1215" y="388.0"/>
