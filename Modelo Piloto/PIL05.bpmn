        <di:waypoint x="158.0" y="413"/>
        <di:waypoint x="212.75" y="413"/>
        <di:waypoint x="212.75" y="113"/>
        <di:waypoint x="267.5" y="113"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL05_f1" bpmnElement="PIL05_f1">
