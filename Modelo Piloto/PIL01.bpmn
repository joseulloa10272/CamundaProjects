<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_PIL01" targetNamespace="https://maderos.example/bpmn/piloto">
  <bpmn:process id="PIL01" name="Comanda digital · alcance del piloto" isExecutable="false">
    <bpmn:documentation>PIL-SERV-01. Actividades 9–23; adicionales y correcciones con registro acotado. Designación previa por chef o sous-chef y confirmación del capitán. El origen, IDs, usuario y hora se conservan. Umbral de 2 minutos propuesto para verificar acuses de pedido o cambio, sujeto a validación antes del piloto. El cambio de canal también aplica ante fallas durante el servicio.</bpmn:documentation>
    <bpmn:laneSet id="PIL01_roles">
      <bpmn:lane id="PIL01_rol0" name="Salonero">
        <bpmn:flowNodeRef>PIL01_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_take</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_channel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_capture</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL01_rol1" name="Aplicación de comandas">
        <bpmn:flowNodeRef>PIL01_send</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL01_rol2" name="Recepción, estación y pase">
        <bpmn:flowNodeRef>PIL01_ack</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_work</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>PIL01_work_merge</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="PIL01_rol3" name="Capitán y Gerencia">
        <bpmn:flowNodeRef>PIL01_setup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_recover</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_paper</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL01_pe</bpmn:flowNodeRef>
      <bpmn:flowNodeRef>PIL01_verify_merge</bpmn:flowNodeRef><bpmn:flowNodeRef>PIL01_paper_merge</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PIL01_s" name="Pedido a la carta">
      <bpmn:outgoing>PIL01_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PIL01_setup" name="Asignar recepción y pase, suplencia y verificar dispositivos">
      <bpmn:incoming>PIL01_f0</bpmn:incoming>
      <bpmn:outgoing>PIL01_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PIL01_take" name="Recibir pedido y abrir servicio con ID, mesa y turno">
      <bpmn:incoming>PIL01_f1</bpmn:incoming>
      <bpmn:outgoing>PIL01_f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL01_channel" name="¿Canal digital disponible?" default="PIL01_f4">
      <bpmn:incoming>PIL01_f2</bpmn:incoming>
      <bpmn:outgoing>PIL01_f3</bpmn:outgoing>
      <bpmn:outgoing>PIL01_f4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PIL01_capture" name="Capturar ítems y opciones obligatorias">
      <bpmn:incoming>PIL01_f3</bpmn:incoming>
      <bpmn:outgoing>PIL01_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PIL01_confirm" name="Reconfirmar resumen con cliente · T3 de referencia">
      <bpmn:incoming>PIL01_f5</bpmn:incoming>
      <bpmn:outgoing>PIL01_f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PIL01_send" name="Validar y transmitir versión sin duplicar el pedido">
      <bpmn:incoming>PIL01_f6</bpmn:incoming>
      <bpmn:outgoing>PIL01_f7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="PIL01_t4" name="Registrar T4 y estado pendiente">
      <bpmn:incoming>PIL01_f7</bpmn:incoming>
      <bpmn:outgoing>PIL01_f8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PIL01_ack" name="Revisar versión y confirmar acuse con usuario y hora">
      <bpmn:incoming>PIL01_f8</bpmn:incoming>
      <bpmn:outgoing>PIL01_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL01_ok" name="¿Acuse verificado?" default="PIL01_f11">
      <bpmn:incoming>PIL01_f9</bpmn:incoming>
      <bpmn:outgoing>PIL01_f10</bpmn:outgoing>
      <bpmn:outgoing>PIL01_f11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PIL01_verify" name="Capitán: verificar acuse a los 2 min sin reenviar como nuevo">
      <bpmn:incoming>PIL01_verify_merge_out</bpmn:incoming><bpmn:outgoing>PIL01_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL01_recover" name="¿Estado digital verificable?" default="PIL01_f14">
      <bpmn:incoming>PIL01_f12</bpmn:incoming>
      <bpmn:outgoing>PIL01_f13</bpmn:outgoing>
      <bpmn:outgoing>PIL01_f14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="PIL01_work" name="Preparar, verificar y entregar por ítem" calledElement="PIL02">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PIL02"/>
      </bpmn:extensionElements>
      <bpmn:incoming>PIL01_work_merge_out</bpmn:incoming><bpmn:outgoing>PIL01_f16</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="false"/>
    </bpmn:callActivity>
    <bpmn:endEvent id="PIL01_e" name="Pedido entregado o resuelto">
      <bpmn:incoming>PIL01_f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:callActivity id="PIL01_paper" name="Activar y conciliar contingencia en papel" calledElement="PIL04">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PIL04"/>
      </bpmn:extensionElements>
      <bpmn:incoming>PIL01_paper_merge_out</bpmn:incoming><bpmn:outgoing>PIL01_f15</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:endEvent id="PIL01_pe" name="Servicio en contingencia documentado">
      <bpmn:incoming>PIL01_f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PIL01_f0" sourceRef="PIL01_s" targetRef="PIL01_setup"/>
    <bpmn:sequenceFlow id="PIL01_f1" sourceRef="PIL01_setup" targetRef="PIL01_take"/>
    <bpmn:sequenceFlow id="PIL01_f2" sourceRef="PIL01_take" targetRef="PIL01_channel"/>
    <bpmn:sequenceFlow id="PIL01_f3" sourceRef="PIL01_channel" targetRef="PIL01_capture" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL01_f4" sourceRef="PIL01_channel" targetRef="PIL01_paper_merge" name="No"/>
    <bpmn:sequenceFlow id="PIL01_f5" sourceRef="PIL01_capture" targetRef="PIL01_confirm"/>
    <bpmn:sequenceFlow id="PIL01_f6" sourceRef="PIL01_confirm" targetRef="PIL01_send"/>
    <bpmn:sequenceFlow id="PIL01_f7" sourceRef="PIL01_send" targetRef="PIL01_t4"/>
    <bpmn:sequenceFlow id="PIL01_f8" sourceRef="PIL01_t4" targetRef="PIL01_ack"/>
    <bpmn:sequenceFlow id="PIL01_f9" sourceRef="PIL01_ack" targetRef="PIL01_ok"/>
    <bpmn:sequenceFlow id="PIL01_f10" sourceRef="PIL01_ok" targetRef="PIL01_work_merge" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL01_f11" sourceRef="PIL01_ok" targetRef="PIL01_verify_merge" name="No"/>
    <bpmn:sequenceFlow id="PIL01_f12" sourceRef="PIL01_verify" targetRef="PIL01_recover"/>
    <bpmn:sequenceFlow id="PIL01_f13" sourceRef="PIL01_recover" targetRef="PIL01_work_merge" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL01_f14" sourceRef="PIL01_recover" targetRef="PIL01_paper_merge" name="No"/>
    <bpmn:sequenceFlow id="PIL01_f15" sourceRef="PIL01_paper" targetRef="PIL01_pe"/>
    <bpmn:sequenceFlow id="PIL01_f16" sourceRef="PIL01_work" targetRef="PIL01_e"/>
  <bpmn:boundaryEvent id="PIL01_plazoAcuse" name="2 min sin acuse · umbral propuesto" attachedToRef="PIL01_ack" cancelActivity="true"><bpmn:outgoing>PIL01_plazoAcuse_f</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration>PT2M</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent><bpmn:sequenceFlow id="PIL01_plazoAcuse_f" sourceRef="PIL01_plazoAcuse" targetRef="PIL01_verify_merge"/><bpmn:exclusiveGateway id="PIL01_verify_merge" gatewayDirection="Converging"><bpmn:incoming>PIL01_f11</bpmn:incoming><bpmn:incoming>PIL01_plazoAcuse_f</bpmn:incoming><bpmn:outgoing>PIL01_verify_merge_out</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="PIL01_verify_merge_out" sourceRef="PIL01_verify_merge" targetRef="PIL01_verify"/><bpmn:exclusiveGateway id="PIL01_work_merge" gatewayDirection="Converging"><bpmn:incoming>PIL01_f10</bpmn:incoming><bpmn:incoming>PIL01_f13</bpmn:incoming><bpmn:outgoing>PIL01_work_merge_out</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="PIL01_work_merge_out" sourceRef="PIL01_work_merge" targetRef="PIL01_work"/><bpmn:exclusiveGateway id="PIL01_paper_merge" gatewayDirection="Converging"><bpmn:incoming>PIL01_f4</bpmn:incoming><bpmn:incoming>PIL01_f14</bpmn:incoming><bpmn:outgoing>PIL01_paper_merge_out</bpmn:outgoing></bpmn:exclusiveGateway><bpmn:sequenceFlow id="PIL01_paper_merge_out" sourceRef="PIL01_paper_merge" targetRef="PIL01_paper"/></bpmn:process>
  <bpmndi:BPMNDiagram id="DG_PIL01">
    <bpmndi:BPMNPlane id="PL_PIL01" bpmnElement="PIL01">
