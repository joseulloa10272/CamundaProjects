        <di:waypoint x="1107.5" y="563"/>
        <di:waypoint x="1127.5" y="563"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f5" bpmnElement="PIL04_f5">
        <di:waypoint x="1302.5" y="563"/>
