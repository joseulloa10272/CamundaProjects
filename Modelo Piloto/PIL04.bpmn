        <di:waypoint x="462.5" y="563"/>
        <di:waypoint x="462.5" y="113"/>
        <di:waypoint x="482.5" y="113"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f2" bpmnElement="PIL04_f2">
        <di:waypoint x="657.5" y="113"/>
