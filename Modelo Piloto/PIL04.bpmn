        <di:waypoint x="677.5" y="413"/>
        <di:waypoint x="697.5" y="413"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f3" bpmnElement="PIL04_f3">
        <di:waypoint x="872.5" y="413"/>
        <di:waypoint x="892.5" y="413"/>
        <di:waypoint x="892.5" y="113"/>
        <di:waypoint x="912.5" y="113"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f4" bpmnElement="PIL04_f4">
