        <di:waypoint x="1322.5" y="263"/>
        <di:waypoint x="1342.5" y="263"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f6" bpmnElement="PIL04_f6">
        <di:waypoint x="1517.5" y="263"/>
        <di:waypoint x="1568.75" y="263"/>
        <di:waypoint x="1568.75" y="563"/>
        <di:waypoint x="1620.0" y="563"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f7" bpmnElement="PIL04_f7">
        <di:waypoint x="1670.0" y="563"/>
        <di:waypoint x="1772.5" y="563"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1703.25" y="543.0" width="36" height="16"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f8" bpmnElement="PIL04_f8">
        <di:waypoint x="1860" y="526.0"/>
        <di:waypoint x="1860" y="501"/>
        <di:waypoint x="1215" y="501"/>
        <di:waypoint x="1215" y="526.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f9" bpmnElement="PIL04_f9">
        <di:waypoint x="1645" y="538.0"/>
        <di:waypoint x="1645" y="500"/>
        <di:waypoint x="2075" y="500"/>
        <di:waypoint x="2075" y="526.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1627.0" y="499.0" width="36" height="16"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f10" bpmnElement="PIL04_f10">
        <di:waypoint x="2162.5" y="563"/>
        <di:waypoint x="2182.5" y="563"/>
        <di:waypoint x="2182.5" y="113"/>
        <di:waypoint x="2202.5" y="113"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL04_f11" bpmnElement="PIL04_f11">
        <di:waypoint x="2377.5" y="113"/>
        <di:waypoint x="2432.25" y="113"/>
        <di:waypoint x="2432.25" y="563"/>
        <di:waypoint x="2487.0" y="563"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
