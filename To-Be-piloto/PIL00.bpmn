<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_PIL00" targetNamespace="https://maderos.example/bpmn/piloto">
  <bpmn:process id="PIL00" name="Restaurante Maderos · Servicio al comensal con comanda digital" isExecutable="false">
    <bpmn:documentation>Modelo general To-Be de Restaurante Maderos. Recepción, espera, asignación de mesa y acondicionamiento delimitan el servicio y conservan su operación habitual. PIL06 integra comanda, preparación por ítem, entregas parciales, pedidos adicionales, inconformidades, cancelación, contingencia y conciliación de cuenta. Alcance intervenido: actividades 9–23 y extensiones acotadas de adicionales y correcciones. El piloto no automatiza cobro ni facturación.</bpmn:documentation>
    <bpmn:laneSet id="PIL00_roles">
      <bpmn:lane id="PIL00_rol0" name="Capitán / recepción">
        <bpmn:flowNodeRef>PIL00_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_availability</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_queue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_wait</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_stay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_leave</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_seat</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL00_rol1" name="Salonero">
        <bpmn:flowNodeRef>PIL00_menu</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_service</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_departure</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL00_rol5" name="Personal de apoyo">
        <bpmn:flowNodeRef>PIL00_reset</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL00_end</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PIL00_start" name="Cliente llega">
      <bpmn:outgoing>PIL00_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PIL00_receive" name="Recibir cliente y consultar tamaño del grupo">
      <bpmn:incoming>PIL00_f0</bpmn:incoming>
      <bpmn:outgoing>PIL00_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL00_availability" name="¿Hay mesa disponible?" default="PIL00_f3">
      <bpmn:incoming>PIL00_f1</bpmn:incoming>
      <bpmn:outgoing>PIL00_f2</bpmn:outgoing>
      <bpmn:outgoing>PIL00_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="PIL00_queue" name="Registrar cliente en lista de espera">
      <bpmn:incoming>PIL00_f3</bpmn:incoming>
      <bpmn:outgoing>PIL00_f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PIL00_wait" name="Esperar mesa disponible o retiro del cliente">
      <bpmn:incoming>PIL00_f4</bpmn:incoming>
      <bpmn:outgoing>PIL00_f5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL00_stay" name="¿Mesa disponible y cliente presente?" default="PIL00_f7">
      <bpmn:incoming>PIL00_f5</bpmn:incoming>
      <bpmn:outgoing>PIL00_f6</bpmn:outgoing>
      <bpmn:outgoing>PIL00_f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PIL00_leave" name="Atención finalizada sin ocupar mesa">
      <bpmn:incoming>PIL00_f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PIL00_seat" name="Asignar mesa y acompañar al cliente">
      <bpmn:incoming>PIL00_f2</bpmn:incoming>
      <bpmn:incoming>PIL00_f6</bpmn:incoming>
      <bpmn:outgoing>PIL00_f8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PIL00_menu" name="Entregar menú y atender consultas">
      <bpmn:incoming>PIL00_f8</bpmn:incoming>
      <bpmn:outgoing>PIL00_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="PIL00_service" name="Gestionar servicio con comanda digital y conciliar cuenta" calledElement="PIL06">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PIL06"/>
      </bpmn:extensionElements>
      <bpmn:incoming>PIL00_f9</bpmn:incoming>
      <bpmn:outgoing>PIL00_f10</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:userTask id="PIL00_departure" name="Verificar que el cliente se retiró">
      <bpmn:incoming>PIL00_f10</bpmn:incoming>
      <bpmn:outgoing>PIL00_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PIL00_reset" name="Retirar vajilla, limpiar y preparar mesa">
      <bpmn:incoming>PIL00_f11</bpmn:incoming>
      <bpmn:outgoing>PIL00_f12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PIL00_end" name="Servicio cerrado y mesa disponible">
      <bpmn:incoming>PIL00_f12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PIL00_f0" sourceRef="PIL00_start" targetRef="PIL00_receive"/>
    <bpmn:sequenceFlow id="PIL00_f1" sourceRef="PIL00_receive" targetRef="PIL00_availability"/>
    <bpmn:sequenceFlow id="PIL00_f2" sourceRef="PIL00_availability" targetRef="PIL00_seat" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL00_f3" sourceRef="PIL00_availability" targetRef="PIL00_queue" name="No"/>
    <bpmn:sequenceFlow id="PIL00_f4" sourceRef="PIL00_queue" targetRef="PIL00_wait"/>
    <bpmn:sequenceFlow id="PIL00_f5" sourceRef="PIL00_wait" targetRef="PIL00_stay"/>
    <bpmn:sequenceFlow id="PIL00_f6" sourceRef="PIL00_stay" targetRef="PIL00_seat" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL00_f7" sourceRef="PIL00_stay" targetRef="PIL00_leave" name="No"/>
    <bpmn:sequenceFlow id="PIL00_f8" sourceRef="PIL00_seat" targetRef="PIL00_menu"/>
    <bpmn:sequenceFlow id="PIL00_f9" sourceRef="PIL00_menu" targetRef="PIL00_service"/>
    <bpmn:sequenceFlow id="PIL00_f10" sourceRef="PIL00_service" targetRef="PIL00_departure"/>
    <bpmn:sequenceFlow id="PIL00_f11" sourceRef="PIL00_departure" targetRef="PIL00_reset"/>
    <bpmn:sequenceFlow id="PIL00_f12" sourceRef="PIL00_reset" targetRef="PIL00_end"/>
  <bpmn:textAnnotation id="PIL00_NotaOrden"><bpmn:text>Pedido digital · reconfirmación · envío · acuse</bpmn:text></bpmn:textAnnotation><bpmn:association id="PIL00_NotaOrden_asoc" sourceRef="PIL00_service" targetRef="PIL00_NotaOrden"/><bpmn:textAnnotation id="PIL00_NotaEntrega"><bpmn:text>Cocina y bebidas · lotes parciales · retiro y entrega</bpmn:text></bpmn:textAnnotation><bpmn:association id="PIL00_NotaEntrega_asoc" sourceRef="PIL00_service" targetRef="PIL00_NotaEntrega"/><bpmn:textAnnotation id="PIL00_NotaExcepciones"><bpmn:text>Adicionales · faltantes · correcciones · cancelación</bpmn:text></bpmn:textAnnotation><bpmn:association id="PIL00_NotaExcepciones_asoc" sourceRef="PIL00_service" targetRef="PIL00_NotaExcepciones"/><bpmn:textAnnotation id="PIL00_NotaCierre"><bpmn:text>Contingencia en papel · conciliación de cuenta</bpmn:text></bpmn:textAnnotation><bpmn:association id="PIL00_NotaCierre_asoc" sourceRef="PIL00_service" targetRef="PIL00_NotaCierre"/></bpmn:process>
  <bpmndi:BPMNDiagram id="DG_PIL00">
    <bpmndi:BPMNPlane id="PL_PIL00" bpmnElement="PIL00">
