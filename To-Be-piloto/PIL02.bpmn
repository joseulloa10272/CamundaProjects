<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Defs_PIL02" targetNamespace="https://maderos.example/bpmn/piloto">
  <bpmn:process id="PIL02" name="Preparar y entregar ítems de la comanda" isExecutable="false">
    <bpmn:documentation>Recorrer por ítem, incluidos alimentos y bebidas con marcas separadas. Respetar orden de recepción salvo excepción registrada por chef. La alerta de 15 minutos desde T3 orienta revisión. El registro se realiza al ocurrir cada transición. Los cambios durante preparación se tramitan con PIL03.</bpmn:documentation>
    <bpmn:laneSet id="PIL02_roles">
      <bpmn:lane id="PIL02_rol0" name="Salonero">
        <bpmn:flowNodeRef>PIL02_change</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_keep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_closed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_verify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_pickup</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_serve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL02_rol1" name="Aplicación de comandas">
        <bpmn:flowNodeRef>PIL02_notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL02_rol2" name="Recepción, estación y pase">
        <bpmn:flowNodeRef>PIL02_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_avail</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_cook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_ready</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="PIL02_rol3" name="Capitán y Gerencia">
        <bpmn:flowNodeRef>PIL02_fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_retry</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PIL02_stop</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="PIL02_s" name="Versión vigente recibida">
      <bpmn:outgoing>PIL02_f0</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="PIL02_stock" name="Revisar disponibilidad del ítem">
      <bpmn:incoming>PIL02_f0</bpmn:incoming>
      <bpmn:incoming>PIL02_f5</bpmn:incoming>
      <bpmn:incoming>PIL02_f15</bpmn:incoming>
      <bpmn:outgoing>PIL02_f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL02_avail" name="¿Ítem disponible?" default="PIL02_f3">
      <bpmn:incoming>PIL02_f1</bpmn:incoming>
      <bpmn:outgoing>PIL02_f2</bpmn:outgoing>
      <bpmn:outgoing>PIL02_f3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="PIL02_change" name="Resolver agotado, cambio, anulación o corrección" calledElement="PIL03">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PIL03"/>
      </bpmn:extensionElements>
      <bpmn:incoming>PIL02_f3</bpmn:incoming>
      <bpmn:outgoing>PIL02_f4</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="PIL02_keep" name="¿Ítem confirmado y vigente?" default="PIL02_f6">
      <bpmn:incoming>PIL02_f4</bpmn:incoming>
      <bpmn:outgoing>PIL02_f5</bpmn:outgoing>
      <bpmn:outgoing>PIL02_f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PIL02_closed" name="Ítem resuelto sin preparar">
      <bpmn:incoming>PIL02_f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PIL02_start" name="Marcar inicio efectivo por ítem">
      <bpmn:incoming>PIL02_f2</bpmn:incoming>
      <bpmn:outgoing>PIL02_f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="PIL02_cook" name="Preparar alimento o bebida">
      <bpmn:incoming>PIL02_f7</bpmn:incoming>
      <bpmn:outgoing>PIL02_f8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="PIL02_ready" name="Verificar y marcar ítem listo en pase">
      <bpmn:incoming>PIL02_f8</bpmn:incoming>
      <bpmn:outgoing>PIL02_f9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="PIL02_notify" name="Enviar aviso y mantener ítem en vista de listos">
      <bpmn:incoming>PIL02_f9</bpmn:incoming>
      <bpmn:outgoing>PIL02_f10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="PIL02_verify" name="Acusar aviso y verificar producto y versión vigente">
      <bpmn:incoming>PIL02_f10</bpmn:incoming>
      <bpmn:outgoing>PIL02_f11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PIL02_match" name="¿Corresponde al pedido?" default="PIL02_f13">
      <bpmn:incoming>PIL02_f11</bpmn:incoming>
      <bpmn:outgoing>PIL02_f12</bpmn:outgoing>
      <bpmn:outgoing>PIL02_f13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="PIL02_fix" name="Registrar y conciliar corrección" calledElement="PIL03">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="PIL03"/>
      </bpmn:extensionElements>
      <bpmn:incoming>PIL02_f13</bpmn:incoming>
      <bpmn:outgoing>PIL02_f14</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="PIL02_retry" name="¿Requiere nueva preparación vigente?" default="PIL02_f16">
      <bpmn:incoming>PIL02_f14</bpmn:incoming>
      <bpmn:outgoing>PIL02_f15</bpmn:outgoing>
      <bpmn:outgoing>PIL02_f16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PIL02_stop" name="Incidencia resuelta sin reentrega">
      <bpmn:incoming>PIL02_f16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="PIL02_pickup" name="Registrar retiro y trasladar">
      <bpmn:incoming>PIL02_f12</bpmn:incoming>
      <bpmn:outgoing>PIL02_f17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="PIL02_serve" name="Servir y registrar entrega · T5 del principal de referencia">
      <bpmn:incoming>PIL02_f17</bpmn:incoming>
      <bpmn:outgoing>PIL02_f18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="PIL02_e" name="Ítem entregado">
      <bpmn:incoming>PIL02_f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PIL02_f0" sourceRef="PIL02_s" targetRef="PIL02_stock"/>
    <bpmn:sequenceFlow id="PIL02_f1" sourceRef="PIL02_stock" targetRef="PIL02_avail"/>
    <bpmn:sequenceFlow id="PIL02_f2" sourceRef="PIL02_avail" targetRef="PIL02_start" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL02_f3" sourceRef="PIL02_avail" targetRef="PIL02_change" name="No"/>
    <bpmn:sequenceFlow id="PIL02_f4" sourceRef="PIL02_change" targetRef="PIL02_keep"/>
    <bpmn:sequenceFlow id="PIL02_f5" sourceRef="PIL02_keep" targetRef="PIL02_stock" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL02_f6" sourceRef="PIL02_keep" targetRef="PIL02_closed" name="No"/>
    <bpmn:sequenceFlow id="PIL02_f7" sourceRef="PIL02_start" targetRef="PIL02_cook"/>
    <bpmn:sequenceFlow id="PIL02_f8" sourceRef="PIL02_cook" targetRef="PIL02_ready"/>
    <bpmn:sequenceFlow id="PIL02_f9" sourceRef="PIL02_ready" targetRef="PIL02_notify"/>
    <bpmn:sequenceFlow id="PIL02_f10" sourceRef="PIL02_notify" targetRef="PIL02_verify"/>
    <bpmn:sequenceFlow id="PIL02_f11" sourceRef="PIL02_verify" targetRef="PIL02_match"/>
    <bpmn:sequenceFlow id="PIL02_f12" sourceRef="PIL02_match" targetRef="PIL02_pickup" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL02_f13" sourceRef="PIL02_match" targetRef="PIL02_fix" name="No"/>
    <bpmn:sequenceFlow id="PIL02_f14" sourceRef="PIL02_fix" targetRef="PIL02_retry"/>
    <bpmn:sequenceFlow id="PIL02_f15" sourceRef="PIL02_retry" targetRef="PIL02_stock" name="Sí">
      <bpmn:conditionExpression>Sí</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PIL02_f16" sourceRef="PIL02_retry" targetRef="PIL02_stop" name="No"/>
    <bpmn:sequenceFlow id="PIL02_f17" sourceRef="PIL02_pickup" targetRef="PIL02_serve"/>
    <bpmn:sequenceFlow id="PIL02_f18" sourceRef="PIL02_serve" targetRef="PIL02_e"/>
  </bpmn:process>
