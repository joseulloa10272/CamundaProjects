      <bpmndi:BPMNEdge id="DI_PIL03_f10" bpmnElement="PIL03_f10">
        <di:waypoint x="2162.5" y="413"/>
        <di:waypoint x="2265.0" y="413"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL03_f11" bpmnElement="PIL03_f11">
        <di:waypoint x="2315.0" y="413"/>
