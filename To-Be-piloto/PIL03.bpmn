        <di:waypoint x="657.5" y="113"/>
        <di:waypoint x="767.0" y="113"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL03_f3" bpmnElement="PIL03_f3">
        <di:waypoint x="355" y="88.0"/>
        <di:waypoint x="355" y="50"/>
        <di:waypoint x="1000" y="50"/>
