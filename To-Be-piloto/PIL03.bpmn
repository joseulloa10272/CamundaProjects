      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL03_init" bpmnElement="PIL03_init">
        <dc:Bounds x="1835.0" y="388.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL03_dec" bpmnElement="PIL03_dec">
        <dc:Bounds x="1987.5" y="376.0" width="175" height="74"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL03_accepted" bpmnElement="PIL03_accepted">
        <dc:Bounds x="2265.0" y="388.0" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DI_PIL03_reject" bpmnElement="PIL03_reject">
