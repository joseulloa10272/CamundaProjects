        <bpmndi:BPMNLabel>
          <dc:Bounds x="337.0" y="49.0" width="36" height="16"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL03_f4" bpmnElement="PIL03_f4">
        <di:waypoint x="1087.5" y="113"/>
        <di:waypoint x="1127.5" y="113"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL03_f5" bpmnElement="PIL03_f5">
        <di:waypoint x="1302.5" y="113"/>
