        <di:waypoint x="1322.5" y="263"/>
        <di:waypoint x="1342.5" y="263"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL03_f6" bpmnElement="PIL03_f6">
