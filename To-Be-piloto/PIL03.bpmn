        <di:waypoint x="1835.0" y="413"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL03_f8" bpmnElement="PIL03_f8">
        <di:waypoint x="1885.0" y="413"/>
        <di:waypoint x="1987.5" y="413"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1918.25" y="393.0" width="36" height="16"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
