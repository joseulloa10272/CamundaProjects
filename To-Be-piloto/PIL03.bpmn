        <di:waypoint x="1537.5" y="413"/>
        <di:waypoint x="1557.5" y="413"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DI_PIL03_f7" bpmnElement="PIL03_f7">
